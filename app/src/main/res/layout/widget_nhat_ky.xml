<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_header_background"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <Button android:id="@+id/widget_add" android:layout_width="30dp" android:layout_height="28dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:background="@drawable/widget_add_background" android:text="+" android:textAllCaps="false" android:textColor="#20242B" android:textSize="15sp" />
        <TextView android:id="@+id/count_new" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="0 Mới" android:textColor="#20242B" android:textSize="9sp" />
        <TextView android:id="@+id/count_processing" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="0 Xử lý" android:textColor="#20242B" android:textSize="9sp" />
        <TextView android:id="@+id/count_done" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="0 Hoàn tất" android:textColor="#20242B" android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_row_background" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/title1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="start|center_vertical" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="Chưa có hồ sơ" android:textColor="#20242B" android:textSize="10sp" />
            <TextView android:id="@+id/status1" android:layout_width="72dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="" android:textColor="#20242B" android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/meta1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="start|center_vertical" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="Nhấn + để ghi nhận" android:textColor="#383D45" android:textSize="9sp" />
            <TextView android:id="@+id/dots1" android:layout_width="72dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:maxLines="1" android:includeFontPadding="false" android:text="" android:textColor="#20242B" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_row_background" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/title2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="start|center_vertical" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="" android:textColor="#20242B" android:textSize="10sp" />
            <TextView android:id="@+id/status2" android:layout_width="72dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="" android:textColor="#20242B" android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/meta2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="start|center_vertical" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="" android:textColor="#383D45" android:textSize="9sp" />
            <TextView android:id="@+id/dots2" android:layout_width="72dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:maxLines="1" android:includeFontPadding="false" android:text="" android:textColor="#20242B" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_row_background" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="2dp" android:paddingBottom="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/title3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="start|center_vertical" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="" android:textColor="#20242B" android:textSize="10sp" />
            <TextView android:id="@+id/status3" android:layout_width="72dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="" android:textColor="#20242B" android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/meta3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="start|center_vertical" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="" android:textColor="#383D45" android:textSize="9sp" />
            <TextView android:id="@+id/dots3" android:layout_width="72dp" android:layout_height="match_parent" android:gravity="end|center_vertical" android:maxLines="1" android:includeFontPadding="false" android:text="" android:textColor="#20242B" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
