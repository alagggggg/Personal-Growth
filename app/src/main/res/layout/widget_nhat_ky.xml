<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="2dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:background="@drawable/widget_header_background" android:padding="2dp">
      <Button android:id="@+id/widget_add" android:layout_width="30dp" android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:background="@drawable/widget_add_background" android:text="+" android:textAllCaps="false" android:textColor="#1477EA" android:textSize="15sp" android:textStyle="bold" />
      <TextView android:id="@+id/count_new" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:maxLines="2" android:text="0\nMới" android:textColor="#FFFFFF" android:textSize="6sp" android:textStyle="bold" />
      <TextView android:id="@+id/count_processing" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:maxLines="2" android:text="0\nXử lý" android:textColor="#FFFFFF" android:textSize="6sp" android:textStyle="bold" />
      <TextView android:id="@+id/count_done" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:maxLines="2" android:text="0\nHoàn tất" android:textColor="#FFFFFF" android:textSize="6sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="2dp" android:layout_height="1dp" />
    <LinearLayout android:id="@+id/row1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row_background" android:padding="3dp">
      <TextView android:id="@+id/accent1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
      <TextView android:id="@+id/categoryEmoji1" android:layout_width="18dp" android:layout_height="match_parent" android:gravity="center" android:textSize="11sp" />
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingStart="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:id="@+id/title1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="7.5sp" android:textStyle="bold" />
          <TextView android:id="@+id/rightInfo1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:maxLines="1" android:textColor="#64748B" android:textSize="5.5sp" />
          <TextView android:id="@+id/status1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:background="@drawable/widget_status_background" android:maxLines="1" android:textColor="#1477EA" android:textSize="6sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:id="@+id/meta1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#6F7E94" android:textSize="6sp" />
          <TextView android:id="@+id/progress1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:maxLines="1" android:textColor="#1477EA" android:textSize="6sp" android:textStyle="bold" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <TextView android:layout_width="1dp" android:layout_height="2dp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <LinearLayout android:id="@+id/row2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row_background" android:padding="3dp">
      <TextView android:id="@+id/accent2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
      <TextView android:id="@+id/categoryEmoji2" android:layout_width="18dp" android:layout_height="match_parent" android:gravity="center" android:textSize="11sp" />
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingStart="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:id="@+id/title2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="7.5sp" android:textStyle="bold" />
          <TextView android:id="@+id/rightInfo2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:maxLines="1" android:textColor="#64748B" android:textSize="5.5sp" />
          <TextView android:id="@+id/status2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:background="@drawable/widget_status_background" android:maxLines="1" android:textColor="#1477EA" android:textSize="6sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:id="@+id/meta2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#6F7E94" android:textSize="6sp" />
          <TextView android:id="@+id/progress2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:maxLines="1" android:textColor="#1477EA" android:textSize="6sp" android:textStyle="bold" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="2dp" android:layout_height="1dp" />
    <LinearLayout android:id="@+id/row3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row_background" android:padding="3dp">
      <TextView android:id="@+id/accent3" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
      <TextView android:id="@+id/categoryEmoji3" android:layout_width="18dp" android:layout_height="match_parent" android:gravity="center" android:textSize="11sp" />
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingStart="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:id="@+id/title3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="7.5sp" android:textStyle="bold" />
          <TextView android:id="@+id/rightInfo3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:maxLines="1" android:textColor="#64748B" android:textSize="5.5sp" />
          <TextView android:id="@+id/status3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:background="@drawable/widget_status_background" android:maxLines="1" android:textColor="#1477EA" android:textSize="6sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:id="@+id/meta3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#6F7E94" android:textSize="6sp" />
          <TextView android:id="@+id/progress3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:maxLines="1" android:textColor="#1477EA" android:textSize="6sp" android:textStyle="bold" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
